{
  "type": "module",
  "private": true,
  "version": "0.7.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "vite build --mode single && mv dist-single/index.html dist-single/activity-tracker.html",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "smoke": "node .claude/skills/run-activity-tracker/driver.mjs smoke",
    "screenshots": "node .claude/skills/run-activity-tracker/driver.mjs docs",
    "start": "scripts/start.sh",
    "start:browser": "scripts/start.sh --browser",
    "start:kiosk": "scripts/start.sh --kiosk"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
